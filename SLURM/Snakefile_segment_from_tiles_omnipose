# Snakefile for omnipose from-tiles segmentation workflow
# Two-stage pipeline mirroring Snakefile_segment_from_tiles:
#   1. segment_tile        — CPU: run omnipose on each pre-split tile, save flows
#   2. reconstruct_from_tiles — CPU: stitch tile flows, run omnipose compute_masks

import os
from pathlib import Path
import glob
import re

# ── Configuration ────────────────────────────────────────────────────────────
INPUT_DIR                = "/users/kir-fritzsche/aif490/devel/tissue_analysis/lymphnode_analysis/data2track/b2-6a_overview_pos1-01_deskew_cgt/crop1/tiles_restored"
OUTPUT_DIR               = "/users/kir-fritzsche/aif490/devel/tissue_analysis/lymphnode_analysis/data2track/b2-6a_overview_pos1-01_deskew_cgt/crop1/tiles_restored_omni_flows"
OUTPUT_DIR_RECONSTRUCTED = "/users/kir-fritzsche/aif490/devel/tissue_analysis/lymphnode_analysis/data2track/b2-6a_overview_pos1-01_deskew_cgt/crop1/tiles_restored_omni_segmented"
MODEL_PATH               = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts/for_training/ph3/training_raw/models/omnipose_3d_ph3_norm_ep0060"
SCRIPT_DIR               = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts"

# ── Inference parameters ─────────────────────────────────────────────────────
TILE_SIZE       = [128, 128, 128]
OVERLAP         = 16
MASK_THRESHOLD  = -2.0
FLOW_THRESHOLD  = 0.4
MIN_SIZE        = 5000

# ── File discovery ───────────────────────────────────────────────────────────
files_to_seg = []
for root, dirs, files in os.walk(INPUT_DIR):
    for file in files:
        if (file.endswith('.tif') or file.endswith('.tiff')) and 'tile' in file:
            files_to_seg.append(os.path.join(root, file))

N_FILES = len(files_to_seg)
file_basenames = [os.path.splitext(os.path.basename(f))[0] for f in files_to_seg]
file_path_map  = {os.path.splitext(os.path.basename(f))[0]: f for f in files_to_seg}

print(f"Found {N_FILES} tile files to process")


def basename_timepoint(basename):
    m = re.search(r'(?<!\w)timepoint_(\d{4})(?!\d)', basename, flags=re.IGNORECASE)
    if m:
        return int(m.group(1))
    m = re.search(r'(?<!\w)tp_?(\d{4})(?!\d)', basename, flags=re.IGNORECASE)
    return int(m.group(1)) if m else None


basename_to_timepoint = {b: basename_timepoint(b) for b in file_basenames}
timepoints = sorted({tp for tp in basename_to_timepoint.values() if tp is not None})

HAS_EXPLICIT_TIMEPOINTS = len(timepoints) > 0
if not HAS_EXPLICIT_TIMEPOINTS:
    timepoints = [0]
    print("No timepoints found in tile names; assuming all tiles belong to timepoint 0000")
else:
    print("Found timepoints:", timepoints)


# ── Rules ────────────────────────────────────────────────────────────────────

rule all:
    input:
        expand(os.path.join(OUTPUT_DIR_RECONSTRUCTED, "restored_timepoint_{timepoint:04d}_segmented.tif"),
               timepoint=timepoints)


rule segment_tile:
    """CPU: run omnipose on each pre-split tile, save stitched flows."""
    input:
        lambda wildcards: file_path_map[wildcards.basename]
    output:
        dp       = os.path.join(OUTPUT_DIR, "{basename}_dP_omni.tif"),
        cellprob = os.path.join(OUTPUT_DIR, "{basename}_cellprob_omni.tif"),
    resources:
        mem_mb          = 8000,
        runtime         = 30,
        cpus            = 1,
        slurm_partition = "short",
        slurm_extra     = "--exclude=compg009,compg010,compg011,compg013"
    log:
        "slogs/omni_from_tiles/segment_{basename}.log"
    shell:
        """
        export TMPDIR=/well/kir-fritzsche/users/aif490/tmp
        mkdir -p $TMPDIR

        module purge
        source /well/kir/config/modules.sh
        module load Python/3.10.8-GCCcore-12.2.0
        source ~/devel/venv/Python-3.10.8-GCCcore-12.2.0/omnipose_env/bin/activate

        python3 -u {SCRIPT_DIR}/tiled_segmentation_omnipose_3d.py \
            --input_file     {input} \
            --output_dir     {OUTPUT_DIR} \
            --model          {MODEL_PATH} \
            --tile_size      {TILE_SIZE[0]} {TILE_SIZE[1]} {TILE_SIZE[2]} \
            --overlap        {OVERLAP} \
            --mask_threshold {MASK_THRESHOLD} \
            --flow_threshold {FLOW_THRESHOLD} \
            --min_size       {MIN_SIZE} \
            --save_flows \
            --verbose &> {log}
        """


rule reconstruct_from_tiles:
    """CPU: stitch per-tile omnipose flows, run compute_masks on full volume."""
    input:
        dp = lambda wildcards: [
            os.path.join(OUTPUT_DIR, f"{b}_dP_omni.tif")
            for b in file_basenames
            if (basename_to_timepoint[b] == int(wildcards.timepoint)) or (not HAS_EXPLICIT_TIMEPOINTS)
        ],
        cellprob = lambda wildcards: [
            os.path.join(OUTPUT_DIR, f"{b}_cellprob_omni.tif")
            for b in file_basenames
            if (basename_to_timepoint[b] == int(wildcards.timepoint)) or (not HAS_EXPLICIT_TIMEPOINTS)
        ]
    output:
        os.path.join(OUTPUT_DIR_RECONSTRUCTED, "restored_timepoint_{timepoint,\d{4}}_segmented.tif")
    params:
        timepoint = lambda wildcards: int(wildcards.timepoint),
    resources:
        mem_mb          = 150000,
        runtime         = 100,
        cpus            = 1,
        slurm_partition = "short",
        slurm_extra     = "--exclude=compg009,compg010,compg011,compg013"
    log:
        "slogs/omni_from_tiles/reconstruct_{timepoint}.log"
    shell:
        """
        export TMPDIR=/well/kir-fritzsche/users/aif490/tmp
        mkdir -p $TMPDIR

        module purge
        source /well/kir/config/modules.sh
        module load Python/3.10.8-GCCcore-12.2.0
        source ~/devel/venv/Python-3.10.8-GCCcore-12.2.0/omnipose_env/bin/activate

        python3 -u {SCRIPT_DIR}/batch_tile_reconstruction.py \
            --tile_dir          {OUTPUT_DIR} \
            --output_dir        {OUTPUT_DIR_RECONSTRUCTED} \
            --timepoint         {params.timepoint} \
            --overlap           {OVERLAP} \
            --min_size          {MIN_SIZE} \
            --flow_threshold    {FLOW_THRESHOLD} \
            --cellprob_threshold {MASK_THRESHOLD} \
            --omni \
            --verbose &> {log}
        """

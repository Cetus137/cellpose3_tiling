# Snakefile for segmentation workflow
# Segment all .tif files in INPUT_DIR and save results as <name>_masks.tif

import os
from pathlib import Path
import glob

# Configuration
INPUT_DIR = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts/for_training/ph3/tiles/ph"
OUTPUT_DIR = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts/for_training/ph3/tiles/ph_segmented_minus4"
MODEL_PATH = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts/models/CP_20250430_181517"
SCRIPT_DIR = "/users/kir-fritzsche/aif490/devel/tissue_analysis/segmentation_scripts"

# Segmentation parameters
GAMMA = 1.0
TILE_SIZE = [256, 288, 288]  # Z, Y, X
OVERLAP = 32
CELLPROB_THRESHOLD = -4.0
MIN_SIZE = 2500

# Discover all input .tif files (exclude already-processed outputs)
input_files = sorted(glob.glob(os.path.join(INPUT_DIR, "*.tif")))
input_files = [f for f in input_files
               if not f.endswith("_masks.tif") and not f.endswith("_segmented.tif")]
SAMPLES = [Path(f).stem for f in input_files]

# Rule to define the final outputs
rule all:
    input:
        expand(os.path.join(OUTPUT_DIR, "{sample}_masks.tif"), sample=SAMPLES)

# Rule to segment a single .tif file
rule segment:
    input:
        os.path.join(INPUT_DIR, "{sample}.tif")
    output:
        os.path.join(OUTPUT_DIR, "{sample}_masks.tif")
    resources:
        mem_mb = 8000,
        runtime = 40,
        cpus = 1,
        slurm_partition = "short",
        slurm_extra = " --exclude=compg009,compg010,compg011,compg013"
    log:
        "slogs/segment_{sample}.log"
    shell:
        """
        module purge
        source /well/kir/config/modules.sh
        module load Python/3.10.8-GCCcore-12.2.0
        module load CUDA/12.0
        source ~/devel/venv/Python-3.10.8-GCCcore-12.2.0/cellpose3_env/bin/activate

        python3 -u {SCRIPT_DIR}/tiled_segmentation_3views.py \
            --input_file {input} \
            --output_dir {OUTPUT_DIR} \
            --model {MODEL_PATH} \
            --gamma {GAMMA} \
            --tile_size {TILE_SIZE[0]} {TILE_SIZE[1]} {TILE_SIZE[2]} \
            --overlap {OVERLAP} \
            --cellprob_threshold {CELLPROB_THRESHOLD} \
            --min_size {MIN_SIZE} \
            --output_suffix _masks \
            --verbose &> {log}
        """
